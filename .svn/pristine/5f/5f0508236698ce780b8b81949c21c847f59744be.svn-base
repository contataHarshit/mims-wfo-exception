<div class="page-container">
  <p-card class="main-form-card">
    <div class="form-grid">
      <div class="form-row">
        <label>Employee Id</label>
        <input pInputText [(ngModel)]="formData.employeeNumber" readonly />
      </div>

      <div class="form-row">
        <label>Employee Name</label>
        <input pInputText [(ngModel)]="formData.employeeName" readonly />
      </div>

      <div class="form-row">
        <label> Manager Name</label>
        <input pInputText [(ngModel)]="formData.projectManager" readonly />
      </div>
    </div>

    <div class="exception-section">
      <h4 class="section-title">Work From Home Details</h4>

      <p-table [value]="formData.exceptions" dataKey="index" class="p-datatable-gridlines"
        [tableStyle]="{ 'min-width': '100%' }">
        <ng-template pTemplate="header">
          <tr>
            <th>#</th>
            <th>Select Date(s) <span style="color: red;">*</span></th>
            <th>Reason <span style="color: red;">*</span></th>
            <th>Remarks <span style="color: red;">*</span></th>
            <th>Action</th>
          </tr>
        </ng-template>

        <ng-template pTemplate="body" let-e let-i="rowIndex">
          <tr>
            <td>{{ i + 1 }}</td>
            <td>
              <app-date-range-picker [(range)]="e.dateRange" [disabledDates]="disabledDates"
                [minDate]="minSelectableDate" [maxDate]="maxSelectableDate" (okClick)="onMultiDateConfirm($event, i)"
                (monthYearChange)="onMonthYearChanged($event)"></app-date-range-picker>
            </td>

            <td>
              <!-- Normal dropdown -->
              <div *ngIf="!e.showOtherReason" class="stable-width">
                <app-common-select [options]="reasonList" [value]="e.primaryReason" placeholder="Select Reason"
                  [searchKey]="'label'" (valueChange)="onPrimaryReasonChange(e, $event)"></app-common-select>
              </div>
              <!-- Other reason input -->
              <div *ngIf="e.showOtherReason" class="stable-width input-wrapper">
                <input pInputText [(ngModel)]="e.otherReason" placeholder="Enter other reason" class="input-with-icons"
                  style="width: 100%;" />
                <i class="pi pi-check inside-icon tick" (click)="confirmOtherReason(e)" title="Confirm"></i>
                <i class="pi pi-times inside-icon cross" (click)="cancelOtherReason(e)" title="Cancel"></i>
              </div>
            </td>

            <td>
              <textarea pInputTextarea [(ngModel)]="e.remarks" rows="1" placeholder="Enter Remarks"></textarea>
            </td>

            <td>
              <button pButton icon="pi pi-trash" class="p-button-rounded p-button-danger p-button-sm"
                (click)="deleteIndex(i)" *ngIf="formData.exceptions.length > 1"></button>
              <button pButton icon="pi pi-plus" class="p-button-rounded p-button-success p-button-sm"
                (click)="addMore()" *ngIf="i === formData.exceptions.length - 1"></button>
            </td>
          </tr>
        </ng-template>
      </p-table>
    </div>

    <div class="form-actions">
      <button pButton label="Reset" class="p-button-danger" (click)="resetForm()"></button>
      <button pButton label="Submit" class="p-button-success" (click)="onSubmit()"></button>
    </div>
  </p-card>
</div>
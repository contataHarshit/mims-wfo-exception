.confirm-popup {
  padding: 20px;
  text-align: center;

  h2 {
    margin-bottom: 15px;
    font-size: 20px;
    font-weight: 600;
  }

  p {
    color: #555;
    margin-bottom: 25px;
    font-size: 15px;
  }

  .button-group {
    display: flex;
    justify-content: center;
    gap: 15px;
  }

  ::ng-deep .p-button {
    padding: 8px 25px;
    border-radius: 8px;
  }
}
